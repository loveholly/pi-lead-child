{
  "name": "@pi-lead-child/components",
  "version": "0.1.0",
  "private": true,
  "description": "Base UI components with one API on web, iOS and Android. Tamagui renders layout, text and the web controls; Expo UI renders the native controls on iOS (SwiftUI) and Android (Jetpack Compose).",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "sideEffects": false,
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.test.json && tsc --noEmit -p tsconfig.ios.json && tsc --noEmit -p tsconfig.android.json"
  },
  "dependencies": {
    "@tamagui/config": "3.0.3",
    "@tamagui/core": "3.0.3"
  },
  "peerDependencies": {
    "@expo-google-fonts/jetbrains-mono": "*",
    "@expo-google-fonts/plus-jakarta-sans": "*",
    "@expo/ui": "*",
    "expo-font": "*",
    "expo-symbols": "*",
    "react": "*",
    "react-native": "*",
    "react-native-reanimated": "*",
    "react-native-safe-area-context": "*",
    "react-native-worklets": "*"
  },
  "devDependencies": {
    "@expo-google-fonts/jetbrains-mono": "^0.4.1",
    "@expo-google-fonts/plus-jakarta-sans": "^0.4.2",
    "@expo/ui": "~57.0.7",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.1.1",
    "@types/react": "~19.2.2",
    "@types/react-dom": "~19.2.3",
    "expo": "~57.0.8",
    "expo-font": "~57.0.1",
    "expo-symbols": "~57.0.1",
    "jsdom": "^30.1.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1",
    "typescript": "~6.0.3",
    "vitest": "^4.1.10"
  }
}
